# ---------------------------------------------------------------------------
# ORCA staging. Nothing here can reach a broker:
#   ORCA_EXECUTION_GATEWAY=paper  +  ORCA_TRADING_ENABLED=false
# Switch ORCA_FEED_PROVIDER to upstox (and add a daily token) when you want
# real market data with simulated fills - that is the useful staging config.
# ---------------------------------------------------------------------------
ORCA_ENV=staging
ORCA_LOG_LEVEL=INFO
ORCA_LOG_FORMAT=full

# Isolated from dev: these live on the staging volume, not ./data
ORCA_DATABASE_URL=sqlite:////data/orca.db
ORCA_MODEL_DIR=/data/models
ORCA_ACTIVE_MODEL=default

# --- feed -------------------------------------------------------------------
ORCA_FEED_PROVIDER=mock
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_ACCESS_TOKEN=          # daily, expires ~03:30 IST
# UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/upstox/callback

# --- execution: never live in staging --------------------------------------
ORCA_EXECUTION_GATEWAY=paper
ORCA_TRADING_ENABLED=false

# --- risk guardrails --------------------------------------------------------
ORCA_MAX_LOTS_PER_TRADE=1
ORCA_MAX_OPEN_TRADES=2
ORCA_MAX_DAY_LOSS=5000
ORCA_DEFAULT_STOP_MULTIPLE=2.0
ORCA_DEFAULT_TARGET_PCT=0.5

# --- web --------------------------------------------------------------------
# Point this at your UI dev server. Staging is still bound to localhost.
# Dashboard login (see .env.example); override the password per environment.
ORCA_AUTH_USERNAME=Admin
ORCA_AUTH_PASSWORD=passwordpassword
ORCA_CORS_ORIGINS=*

# --- scheduler: set per container by compose/Makefile ----------------------
ORCA_SNAPSHOT_INTERVAL_SEC=60
ORCA_TRACKER_INTERVAL_SEC=15
