# ---------------------------------------------------------------------------
# ORCA configuration. Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------
ORCA_ENV=dev
ORCA_LOG_LEVEL=INFO

# Database (SQLite by default; swap for postgresql+psycopg://user:pass@host/orca)
ORCA_DATABASE_URL=sqlite:///./data/orca.db

# --- Data feed: UPSTOX -----------------------------------------------------
# "mock" generates a synthetic chain so the app runs with no credentials.
ORCA_FEED_PROVIDER=mock
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/upstox/callback
# Daily access token (expires ~03:30 IST next day). Obtained via login flow.
UPSTOX_ACCESS_TOKEN=

# --- Order execution: ZERODHA KITE ----------------------------------------
# "paper" simulates fills locally. Use "kite" only when you intend live orders.
ORCA_EXECUTION_GATEWAY=paper
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- Trading / risk guardrails --------------------------------------------
ORCA_TRADING_ENABLED=false          # master switch for sending real orders
ORCA_MAX_LOTS_PER_TRADE=2
ORCA_MAX_OPEN_TRADES=3
ORCA_MAX_DAY_LOSS=15000             # INR; tracker flags breach
ORCA_DEFAULT_STOP_MULTIPLE=2.0      # stop at 2x credit received
ORCA_DEFAULT_TARGET_PCT=0.5         # book at 50% of credit

# --- Web API ---------------------------------------------------------------
# Origins allowed to call /api. Set this to your UI's origin before the API is
# reachable from anywhere but localhost - there is no authentication yet.
ORCA_CORS_ORIGINS=*
# e.g. ORCA_CORS_ORIGINS=http://localhost:5173,https://orca-ui.internal

# --- Scheduler -------------------------------------------------------------
ORCA_SCHEDULER_ENABLED=true
ORCA_SNAPSHOT_INTERVAL_SEC=60       # option-chain capture cadence (ML training data)
ORCA_TRACKER_INTERVAL_SEC=15        # open-position MTM cadence

# --- ML --------------------------------------------------------------------
ORCA_MODEL_DIR=./data/models
ORCA_ACTIVE_MODEL=default
